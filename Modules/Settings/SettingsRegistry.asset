      type: {class: VSyncSetting, ns: AbstractPixel.Settings, asm: AbstractPixel.Settings}
      data:
        <IsEnabled>k__BackingField: 1
        editorDebugToolbar: 0
        <CurrentValue>k__BackingField: 0
        <IsActive>k__BackingField: 1
        <Metadata>k__BackingField:
          DisplayName: VSync Quality
          Description: "Stops screen tearing by syncing the game\u2019s frame rate
            to your monitor's refresh rate.\r\n\r\n1. <b>Off:</b> Gives the fastest
            response time, but the screen might tear.\r\n2. <b>Every V-Blank:</b>
            Matches your monitor's  refresh rate \r\n3. <b>Every 2nd V-Blank:</b>
            Cuts the speed in half (e.g., 30 FPS on  60Hz monitor).\r\n4. <b>Every
            3rd V-Blank:</b> Cuts the speed to one-third (e.g., 20 FPS on  60Hz monitor)."
        <DefaultValue>k__BackingField: 0
        dependencyRulesList: []
        <OptionValues>k__BackingField: 00000000010000000200000003000000
        <OptionDisplayNames>k__BackingField:
        - Off
        - Every V Blank
        - Every Second V Blank
        - Every Third V Blank
