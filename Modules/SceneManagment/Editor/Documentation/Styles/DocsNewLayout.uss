.docs-part-fold > .unity-foldout__content > .docs-facts.docs-last,
.docs-part-fold > .unity-foldout__content > .docs-code.docs-last,
.docs-part-fold > .unity-foldout__content > .docs-callout.docs-last,
.docs-part-fold > .unity-foldout__content > .docs-flow.docs-last,
.docs-part-fold > .unity-foldout__content > .docs-part-fold.docs-last,
.docs-part-fold > .unity-foldout__content > .docs-action-fold.docs-last,
.docs-part-fold > .unity-foldout__content > .docs-fold.docs-last,
.docs-part-fold > .unity-foldout__content > .docs-locate.docs-last,
.docs-part-fold > .unity-foldout__content > .docs-action-group-facts.docs-last,
.docs-fold > .unity-foldout__content > .docs-table.docs-last,
.docs-fold > .unity-foldout__content > .docs-facts.docs-last,
.docs-fold > .unity-foldout__content > .docs-code.docs-last,
.docs-fold > .unity-foldout__content > .docs-callout.docs-last,
.docs-fold > .unity-foldout__content > .docs-flow.docs-last,
.docs-fold > .unity-foldout__content > .docs-part-fold.docs-last,
.docs-fold > .unity-foldout__content > .docs-action-fold.docs-last,
.docs-fold > .unity-foldout__content > .docs-fold.docs-last,
.docs-fold > .unity-foldout__content > .docs-locate.docs-last,
.docs-fold > .unity-foldout__content > .docs-action-group-facts.docs-last,
.docs-action-fold > .unity-foldout__content > .docs-table.docs-last,
.docs-action-fold > .unity-foldout__content > .docs-facts.docs-last,
.docs-action-fold > .unity-foldout__content > .docs-code.docs-last,
.docs-action-fold > .unity-foldout__content > .docs-callout.docs-last,
.docs-action-fold > .unity-foldout__content > .docs-flow.docs-last,
.docs-action-fold > .unity-foldout__content > .docs-part-fold.docs-last,
.docs-action-fold > .unity-foldout__content > .docs-action-fold.docs-last,
.docs-action-fold > .unity-foldout__content > .docs-fold.docs-last,
.docs-action-fold > .unity-foldout__content > .docs-locate.docs-last,
.docs-action-fold > .unity-foldout__content > .docs-action-group-facts.docs-last {
    margin-bottom: 0;
}

/* Rows and table cells line their text up with the paragraphs. */
.docs-facts-row {
    padding-left: 14px;
    padding-right: 14px;
}

.docs-layout-new .docs-table .docs-table-first {
    padding-left: 14px;
}

.docs-layout-new .docs-table .docs-table-in-group .docs-table-first {
    padding-left: 30px;
}

.docs-layout-new .docs-code {
    border-top-width: 1px;
    border-bottom-width: 1px;
}

.docs-layout-new .docs-callout {
    border-top-width: 1px;
    border-bottom-width: 1px;
}

/* Part strips: one after another, closed by default. A line under a strip only while it is open. */
.docs-part-fold > .unity-foldout__toggle,
.docs-section-body > .docs-part-fold.docs-first > .unity-foldout__toggle {
    margin: 0;
    padding: 3px 10px;
    border-top-width: 1px;
    border-bottom-width: 0;
}

.docs-part-fold > .unity-foldout__toggle:checked {
    border-bottom-width: 1px;
}

.docs-section-body > .docs-part-fold.docs-first > .unity-foldout__toggle {
    border-top-width: 0;
}

/* The button box: the button on its strip, the rows inside. */
.docs-action-fold {
    margin-top: 2px;
    margin-bottom: 12px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: var(--unity-colors-inspector_titlebar-border);
}

.docs-action-fold.docs-last {
    border-bottom-width: 0;
}

.docs-action-fold > .unity-foldout__toggle {
    margin: 0;
    padding: 3px 10px;
}

.docs-action-fold > .unity-foldout__toggle .unity-toggle__input {
    align-items: center;
}

.docs-action-fold > .unity-foldout__toggle .unity-toggle__text {
    display: none;
}

.docs-action-fold > .unity-foldout__toggle:checked {
    border-bottom-width: 1px;
    border-color: var(--unity-colors-inspector_titlebar-border);
}

.docs-layout-new .docs-strip-action {
    margin: 0 8px 0 0;
    align-self: center;
}

.docs-action-fold .docs-facts-row {
    margin-bottom: 0;
}

/* More foldouts inside a box: a strip whose title lines up with the text. */
.docs-section-body > .docs-fold,
.docs-part-fold > .unity-foldout__content > .docs-fold {
    margin-top: 0;
    margin-bottom: 12px;
}

.docs-section-body > .docs-fold > .unity-foldout__toggle,
.docs-part-fold > .unity-foldout__content > .docs-fold > .unity-foldout__toggle {
    margin: 0;
    padding: 3px 10px;
}

.docs-fold > .unity-foldout__content > .docs-paragraph.docs-first {
    margin-top: 8px;
}

/* A member's More keeps its bullets right under the summary. */
.docs-mrow-more > .unity-foldout__content > * {
    margin-left: 0;
    margin-right: 0;
}

/* Where a component lives: a Unity toolbar across the box. */
.docs-locate {
    border-top-width: 1px;
    border-bottom-width: 1px;
    margin-bottom: 12px;
    padding-left: 10px;
    align-items: center;
}

.docs-locate-lead {
    color: var(--unity-colors-label-text);
    margin-right: 6px;
    -unity-text-align: middle-left;
}

.docs-locate-item {
    flex-direction: row;
    align-items: center;
}

.docs-locate-icon {
    width: 16px;
    height: 16px;
    margin-right: 3px;
}

.docs-locate-text {
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.docs-locate-separator {
    padding: 0 6px;
    opacity: 0.6;
    -unity-text-align: middle-left;
}

.docs-locate-select {
    -unity-font-style: bold;
}

/* Code meets the box's edges; its title and lines start where the text does. */
.docs-layout-new .docs-code-header,
.docs-layout-new .docs-code-scroll {
    padding-left: 10px;
    padding-right: 10px;
}

/* Phases of a flow run to the box's edges; plain numbered steps keep the text margin. */
.docs-section-body > .docs-flow .docs-flow-phase,
.docs-part-fold > .unity-foldout__content > .docs-flow .docs-flow-phase {
    margin-left: -14px;
    margin-right: -14px;
    padding-left: 24px;
}

.docs-layout-new .docs-callout {
    margin-top: 0;
}

.docs-fold > .unity-foldout__content > .docs-first {
    margin-top: 8px;
}

.docs-fold > .unity-foldout__content > .docs-facts.docs-first {
    margin-top: 0;
}

/* ---- A box inside a box: inset from the outer box on every side, its own outline, a header row, and its
   rows right against its edges (no padding inside). Callouts are inset the same way. ---- */
.docs-section-body > .docs-inner-box,
.docs-section-body > .docs-callout,
.docs-part-fold > .unity-foldout__content > .docs-inner-box,
.docs-part-fold > .unity-foldout__content > .docs-callout,
.docs-fold > .unity-foldout__content > .docs-inner-box,
.docs-fold > .unity-foldout__content > .docs-callout,
.docs-action-fold > .unity-foldout__content > .docs-inner-box,
.docs-action-fold > .unity-foldout__content > .docs-callout {
    margin: 0 10px 12px 10px;
    border-width: 1px;
    border-radius: 3px;
    border-top-color: var(--unity-colors-inspector_titlebar-border);
    border-right-color: var(--unity-colors-inspector_titlebar-border);
    border-bottom-color: var(--unity-colors-inspector_titlebar-border);
    overflow: hidden;
    max-width: none;
}

.docs-section-body > .docs-inner-box.docs-first,
.docs-section-body > .docs-callout.docs-first,
.docs-part-fold > .unity-foldout__content > .docs-inner-box.docs-first,
.docs-part-fold > .unity-foldout__content > .docs-callout.docs-first,
.docs-fold > .unity-foldout__content > .docs-inner-box.docs-first,
.docs-fold > .unity-foldout__content > .docs-callout.docs-first,
.docs-action-fold > .unity-foldout__content > .docs-inner-box.docs-first,
.docs-action-fold > .unity-foldout__content > .docs-callout.docs-first {
    margin-top: 10px;
}

.docs-section-body > .docs-inner-box.docs-last,
.docs-section-body > .docs-callout.docs-last,
.docs-part-fold > .unity-foldout__content > .docs-inner-box.docs-last,
.docs-part-fold > .unity-foldout__content > .docs-callout.docs-last,
.docs-fold > .unity-foldout__content > .docs-inner-box.docs-last,
.docs-fold > .unity-foldout__content > .docs-callout.docs-last,
.docs-action-fold > .unity-foldout__content > .docs-inner-box.docs-last,
.docs-action-fold > .unity-foldout__content > .docs-callout.docs-last {
    margin-bottom: 10px;
}

.docs-section-body > .docs-callout,
.docs-part-fold > .unity-foldout__content > .docs-callout,
.docs-fold > .unity-foldout__content > .docs-callout,
.docs-action-fold > .unity-foldout__content > .docs-callout {
    border-left-width: 3px;
}

.docs-inner-box > .unity-foldout__toggle {
    margin: 0;
    padding: 3px 8px;
    border-width: 0;
}

.docs-inner-box > .unity-foldout__toggle:checked {
    border-bottom-width: 1px;
    border-color: var(--unity-colors-inspector_titlebar-border);
}

.docs-inner-box > .unity-foldout__content {
    margin: 0;
    padding: 0;
}

/* Rows inside an inner box start at its edge, their text a little in. */
.docs-inner-box .docs-facts-row {
    padding-left: 10px;
    padding-right: 10px;
}

/* Flow phases are inner boxes too, with their accent edge; steps sit inside with a small margin. */
.docs-flow .docs-flow-phase.docs-inner-box {
    margin: 0 -4px 8px -4px;
    padding: 0;
    border-width: 1px;
    border-left-width: 3px;
    border-radius: 3px;
    border-color: var(--unity-colors-inspector_titlebar-border);
    overflow: hidden;
}

.docs-flow-phase.docs-inner-box > .unity-foldout__toggle .unity-toggle__text {
    -unity-font-style: bold;
}

.docs-flow-phase.docs-inner-box > .unity-foldout__content {
    padding: 6px 10px 2px 10px;
}

.docs-flow-number {
    width: auto;
    min-width: 20px;
    padding: 0 4px;
}

/* Callouts keep their coloured left edge; only the other three sides take the outline colour. */
.docs-section-body > .docs-callout,
.docs-part-fold > .unity-foldout__content > .docs-callout,
.docs-fold > .unity-foldout__content > .docs-callout,
.docs-action-fold > .unity-foldout__content > .docs-callout {
    border-left-width: 3px;
    border-top-color: var(--unity-colors-inspector_titlebar-border);
    border-right-color: var(--unity-colors-inspector_titlebar-border);
    border-bottom-color: var(--unity-colors-inspector_titlebar-border);
}

.docs-flow-number {
    min-width: 32px;
}

/* Inner boxes take the outline colour on their left side too (callouts keep their coloured edge). */
.docs-section-body > .docs-inner-box,
.docs-part-fold > .unity-foldout__content > .docs-inner-box,
.docs-fold > .unity-foldout__content > .docs-inner-box,
.docs-action-fold > .unity-foldout__content > .docs-inner-box {
    border-left-color: var(--unity-colors-inspector_titlebar-border);
}

.docs-type-declaration {
    border-left-width: 1px;
    border-left-color: var(--unity-colors-default-border);
}

/* Buttons on the page grow with the text; Unity's button style would keep them at its own size. */
.docs-page-area .unity-button,
.docs-page-area .unity-button .unity-label,
.docs-page-area .unity-toolbar-button {
    font-size: var(--unity-metrics-default-font_normal_size);
}

.docs-facts-label {
    width: 210px;
}

.docs-page-area .docs-locate Label {
    font-size: var(--unity-metrics-default-font_normal_size);
}

.docs-page-area .docs-locate {
    height: 28px;
}

/* Body text is 20% smaller than the page's normal size (15 -> 12 px); headings, titles and buttons keep theirs. */
.docs-layout-new .docs-text,
.docs-layout-new .docs-facts-label,
.docs-layout-new .docs-facts-value {
    font-size: 12px;
}

/* Numbered steps keep the same gap from the strip or header above and the box edge below as text does. */
.docs-section-body > .docs-flow.docs-first,
.docs-part-fold > .unity-foldout__content > .docs-flow.docs-first,
.docs-fold > .unity-foldout__content > .docs-flow.docs-first,
.docs-action-fold > .unity-foldout__content > .docs-flow.docs-first {
    margin-top: 10px;
}

.docs-section-body > .docs-flow.docs-last,
.docs-part-fold > .unity-foldout__content > .docs-flow.docs-last,
.docs-fold > .unity-foldout__content > .docs-flow.docs-last,
.docs-action-fold > .unity-foldout__content > .docs-flow.docs-last {
    margin-bottom: 10px;
}

/* "Select the script" and "Open script in IDE" side by side, 6 px apart. */
.docs-action-row {
    flex-direction: row;
    align-items: center;
}

.docs-action-row > Button {
    margin: 0 6px 0 0;
}

/* Callouts hug their text: a small even padding and no paragraph gap after the last line. */
.docs-layout-new .docs-callout {
    padding: 8px 12px 8px 12px;
}

.docs-layout-new .docs-callout .docs-paragraph {
    margin-bottom: 0;
}

/* ---- Tables are boxes of their own, like the "More" boxes: inset 10 px from the outer box, a 1 px outline on all
   four sides, rounded corners, and a light grey header row. ---- */
.docs-section-body > .docs-table,
.docs-part-body > .docs-table,
.docs-part-fold > .unity-foldout__content > .docs-table,
.docs-fold > .unity-foldout__content > .docs-table,
.docs-action-fold > .unity-foldout__content > .docs-table {
    margin: 0 10px 12px 10px;
    border-width: 1px;
    border-radius: 3px;
    border-top-color: var(--unity-colors-inspector_titlebar-border);
    border-right-color: var(--unity-colors-inspector_titlebar-border);
    border-bottom-color: var(--unity-colors-inspector_titlebar-border);
    border-left-color: var(--unity-colors-inspector_titlebar-border);
    overflow: hidden;
}

.docs-section-body > .docs-table.docs-first,
.docs-part-body > .docs-table.docs-first,
.docs-part-fold > .unity-foldout__content > .docs-table.docs-first,
.docs-fold > .unity-foldout__content > .docs-table.docs-first,
.docs-action-fold > .unity-foldout__content > .docs-table.docs-first {
    margin-top: 10px;
}

.docs-section-body > .docs-table.docs-last,
.docs-part-body > .docs-table.docs-last,
.docs-part-fold > .unity-foldout__content > .docs-table.docs-last,
.docs-fold > .unity-foldout__content > .docs-table.docs-last,
.docs-action-fold > .unity-foldout__content > .docs-table.docs-last {
    margin-bottom: 10px;
    border-bottom-width: 1px;
}

.docs-layout-new .docs-table .docs-table-first {
    padding-left: 10px;
}

.docs-layout-new .docs-table .docs-table-in-group .docs-table-first {
    padding-left: 26px;
}

/* ---- Code blocks are boxes too, inset and outlined like tables, never edge to edge. ---- */
.docs-section-body > .docs-code,
.docs-part-body > .docs-code,
.docs-part-fold > .unity-foldout__content > .docs-code,
.docs-fold > .unity-foldout__content > .docs-code,
.docs-action-fold > .unity-foldout__content > .docs-code {
    margin: 0 10px 12px 10px;
    border-width: 1px;
    border-radius: 3px;
    border-top-color: var(--unity-colors-inspector_titlebar-border);
    border-right-color: var(--unity-colors-inspector_titlebar-border);
    border-bottom-color: var(--unity-colors-inspector_titlebar-border);
    border-left-color: var(--unity-colors-inspector_titlebar-border);
    overflow: hidden;
}

.docs-section-body > .docs-code.docs-first,
.docs-part-body > .docs-code.docs-first,
.docs-part-fold > .unity-foldout__content > .docs-code.docs-first,
.docs-fold > .unity-foldout__content > .docs-code.docs-first,
.docs-action-fold > .unity-foldout__content > .docs-code.docs-first {
    margin-top: 10px;
}

.docs-section-body > .docs-code.docs-last,
.docs-part-body > .docs-code.docs-last,
.docs-part-fold > .unity-foldout__content > .docs-code.docs-last,
.docs-fold > .unity-foldout__content > .docs-code.docs-last,
.docs-action-fold > .unity-foldout__content > .docs-code.docs-last {
    margin-bottom: 10px;
    border-bottom-width: 1px;
}

/* On type pages: a wide rule between the brief part (declaration, script buttons, Read more) and the detail. */
.docs-type-separator {
    height: 3px;
    margin: 18px 0 6px 0;
    background-color: rgb(235, 235, 235);
    border-radius: 2px;
}

/* Screenshots: the image on the left, its numbered labels and caption beside it; they wrap underneath on a narrow page. */
.docs-figure-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

.docs-figure-row > .docs-image-frame {
    flex-shrink: 1;
    flex-grow: 0;
}

.docs-figure-side {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 260px;
    min-width: 220px;
    margin-left: 16px;
    padding-top: 4px;
}

.docs-figure-side > .docs-mark-list {
    margin-top: 0;
}

.docs-layout-new .docs-figure {
    margin-bottom: 12px;
}

/* Code map boxes: the second line wraps to two lines instead of ending in "...". */
.docs-graph-box > .docs-graph-line {
    white-space: normal;
    text-overflow: clip;
    overflow: hidden;
    max-height: 36px;
}

/* Enum values: the value on the left, one line of meaning beside it. */
.docs-mrow-value {
    align-items: center;
}

.docs-mrow-value-name {
    width: 300px;
    flex-shrink: 0;
    padding-right: 12px;
}

/* Image marks: a box of rows, number | name | what it is, outlined on all four sides like the other inner boxes. */
.docs-mark-table {
    border-width: 1px;
    border-radius: 3px;
    border-top-color: var(--unity-colors-inspector_titlebar-border);
    border-right-color: var(--unity-colors-inspector_titlebar-border);
    border-bottom-color: var(--unity-colors-inspector_titlebar-border);
    border-left-color: var(--unity-colors-inspector_titlebar-border);
    overflow: hidden;
    margin-bottom: 8px;
}

.docs-mark-table > .docs-mark-row {
    align-items: flex-start;
    padding: 6px 10px;
    margin-bottom: 0;
}

.docs-mark-table > .docs-mark-row-alt {
    background-color: rgba(128, 128, 128, 0.08);
}

.docs-mark-table .docs-mark-number {
    margin-top: 1px;
    flex-shrink: 0;
}

.docs-mark-name {
    width: 150px;
    flex-shrink: 0;
    -unity-font-style: bold;
    padding-right: 10px;
}

.docs-mark-meaning {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

/* The scene status demo: state buttons in a row, the real status box, one line on what the state means. */
.docs-status-demo {
    margin: 10px 14px 12px 14px;
}

.docs-status-demo-buttons {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 4px;
}

.docs-status-demo-button {
    margin: 0 6px 6px 0;
}

.docs-status-demo-meaning {
    margin-top: 2px;
}

/* ---- Code block header: its own darker band with a clear line under it, a C# badge, and flat actions that belong
   to the block instead of Unity buttons. ---- */
.docs-layout-new .docs-code-header {
    padding-top: 5px;
    padding-bottom: 5px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(78, 78, 78);
    background-color: rgba(0, 0, 0, 0.32);
}

.docs-code-language {
    -unity-font-style: bold;
    color: rgb(170, 140, 200);
    margin: 0 8px 0 0;
    padding: 0;
}

.docs-layout-new .docs-code-header > .docs-code-action {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 3px;
    margin: 0 0 0 4px;
    padding: 2px 8px;
    align-self: center;
}

/* Icon first; the text slides out on hover. */
.docs-layout-new .docs-code-header > .docs-code-action {
    flex-direction: row;
    align-items: center;
    color: rgb(170, 170, 170);
}

.docs-code-icon {
    flex-shrink: 0;
}

.docs-layout-new .docs-code-header > .docs-code-action .docs-code-action-label {
    color: rgb(170, 170, 170);
    font-size: 12px;
    max-width: 0;
    margin-left: 0;
    overflow: hidden;
    white-space: nowrap;
    padding: 0;
    transition-property: max-width, margin-left;
    transition-duration: 0.18s;
    transition-timing-function: ease-out;
}

.docs-layout-new .docs-code-header > .docs-code-action:hover .docs-code-action-label {
    max-width: 90px;
    margin-left: 5px;
}

.docs-layout-new .docs-code-header > .docs-code-action:hover {
    background-color: rgba(255, 255, 255, 0.09);
}

.docs-layout-new .docs-code-header > .docs-code-action:hover,
.docs-layout-new .docs-code-header > .docs-code-action:hover .docs-code-action-label {
    color: rgb(235, 235, 235);
}

/* "On this page": the part being read is marked, and its section keeps a quieter mark. */
.docs-rail-current-parent .docs-rail-text,
.docs-rail-current-parent .docs-rail-number {
    color: var(--unity-colors-highlight-background);
    -unity-font-style: bold;
}

/* The heading or part strip a rail click jumped to lights up for a moment. */
.docs-layout-new .docs-section .docs-heading-row.docs-rail-target,
.docs-layout-new .docs-section-body .docs-part-fold > .unity-foldout__toggle.docs-rail-target,
.docs-layout-new .docs-section-body .docs-part-fold > .unity-foldout__toggle.docs-rail-target:checked {
    background-color: rgba(58, 121, 187, 0.45);
    transition-property: background-color;
    transition-duration: 0.4s;
}

/* Member sections (Properties, Methods, Values...) fold from their header, closed by default. */
.docs-member-heading {
    cursor: link;
}

.docs-member-arrow {
    width: 14px;
    margin-right: 4px;
    -unity-text-align: middle-center;
    color: var(--unity-colors-label-text);
}
