/* The new page layout, for pages with a "layout new" line. Colours for kinds and states are in DocsDark.uss and DocsLight.uss. */
.docs-page.docs-layout-new {
    max-width: 930px;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 16px;
    padding-bottom: 32px;
}

.docs-layout-new .docs-title-row {
    margin-bottom: 12px;
}

.docs-layout-new .docs-paragraph {
    max-width: 720px;
    margin-bottom: 12px;
}

/* A concept starts with a full-width heading bar and room above it. */
.docs-layout-new .docs-h2 {
    margin-top: 32px;
    margin-bottom: 0;
    padding: 6px 8px;
    background-color: var(--unity-colors-inspector_titlebar-background);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: var(--unity-colors-inspector_titlebar-border);
}

.docs-layout-new .docs-h3 {
    margin-top: 20px;
    margin-bottom: 8px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}

.docs-layout-new .docs-list {
    margin-bottom: 12px;
    max-width: 720px;
}

.docs-layout-new .docs-list-row {
    margin-bottom: 6px;
}

.docs-layout-new .docs-callout {
    padding: 10px 12px;
    margin-top: 4px;
    margin-bottom: 14px;
    max-width: 720px;
}

.docs-layout-new .docs-code {
    margin-top: 4px;
    margin-bottom: 14px;
}

.docs-layout-new .docs-steps {
    margin-bottom: 12px;
}

.docs-layout-new .docs-step {
    padding-top: 4px;
    padding-bottom: 4px;
}

.docs-layout-new .docs-action {
    margin-bottom: 12px;
}

/* Tables: roomy cells, a divider under every row. */
.docs-layout-new .docs-table {
    margin-bottom: 14px;
}

.docs-layout-new .docs-table-row {
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}

.docs-layout-new .docs-table-cell {
    padding: 6px 10px;
}

/* Fact rows: label column, value column, a divider between rows. */
.docs-facts {
    margin-bottom: 14px;
    border-top-width: 1px;
    border-top-color: var(--unity-colors-default-border);
}

.docs-facts-row {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 6px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}

.docs-facts-label {
    width: 170px;
    flex-shrink: 0;
    padding: 0 12px 0 0;
    margin: 0;
    color: var(--unity-colors-label-text);
    white-space: normal;
}

.docs-facts-value {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 200px;
}

/* Flow: numbered circles, steps grouped in phases. */
.docs-flow {
    margin-bottom: 14px;
}

.docs-flow-phase {
    margin-bottom: 10px;
    padding: 8px 10px 4px 10px;
    border-left-width: 3px;
    background-color: var(--unity-colors-alternated_rows-background);
}

.docs-flow-phase-title {
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.docs-flow-step {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.docs-flow-number {
    width: 20px;
    height: 20px;
    border-radius: 10px;
    border-width: 1px;
    -unity-text-align: middle-center;
    font-size: var(--unity-metrics-default-font_small_size);
    margin: 0 10px 0 0;
    padding: 0;
    flex-shrink: 0;
}

.docs-flow-text {
    flex-shrink: 1;
    flex-grow: 1;
}

/* Foldouts: a quiet toggle, the inside indented behind a line. */
.docs-fold {
    margin-top: 4px;
    margin-bottom: 12px;
}

.docs-fold .unity-foldout__text {
    color: var(--unity-colors-label-text);
}

.docs-fold > .unity-foldout__content {
    margin-left: 6px;
    padding: 8px 0 2px 14px;
    border-left-width: 2px;
    border-left-color: var(--unity-colors-default-border);
}

/* Type header */
.docs-type-header {
    margin-bottom: 14px;
}

.docs-type-declaration {
    font-size: 13px;
    padding: 8px 12px;
    margin-bottom: 10px;
    background-color: var(--unity-colors-default-background);
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
    white-space: normal;
}

/* Member tables: one box per kind, a coloured edge per row. */
.docs-member-count {
    font-size: var(--unity-metrics-default-font_small_size);
    color: var(--unity-colors-label-text);
    margin-right: 6px;
    padding: 0 5px;
    border-radius: 3px;
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
}

.docs-member-table {
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
    background-color: var(--unity-colors-default-background);
    margin-bottom: 8px;
}

.docs-mrow {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 8px 10px;
    border-left-width: 3px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
    transition-property: background-color;
    transition-duration: 1s;
}

.docs-mrow-type {
    width: 190px;
    flex-shrink: 0;
    padding: 0 12px 0 0;
    white-space: normal;
    -unity-text-align: upper-right;
}

.docs-mrow-main {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 260px;
}

.docs-mrow-signature {
    white-space: normal;
}

.docs-mrow-summary {
    margin-top: 3px;
}

.docs-mrow-more {
    margin-top: 4px;
    margin-bottom: 0;
}

.docs-narrow .docs-mrow-type {
    -unity-text-align: upper-left;
    width: 100%;
}

/* Design decisions */
.docs-decision-list {
    border-top-width: 1px;
    border-top-color: var(--unity-colors-default-border);
    margin-bottom: 14px;
}

.docs-decision-row {
    flex-direction: row;
    align-items: center;
    margin: 0;
    padding: 8px;
    border-radius: 0;
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
    background-color: rgba(0, 0, 0, 0);
    transition-property: background-color;
    transition-duration: 0.1s;
}

.docs-decision-row:hover {
    background-color: var(--unity-colors-button-background-hover);
}

.docs-decision-number {
    width: 34px;
    flex-shrink: 0;
    color: var(--unity-colors-label-text);
    -unity-text-align: middle-left;
}

.docs-decision-title {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    -unity-text-align: middle-left;
    color: var(--unity-colors-link-text);
}

.docs-decision-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.docs-decision-caption {
    color: var(--unity-colors-label-text);
    margin-right: 8px;
}

/* Pager cards: two equal halves that never overflow. */
.docs-pager-cards {
    flex-direction: row;
    margin-top: 40px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: var(--unity-colors-default-border);
}

.docs-pager-card,
.docs-pager-card-space {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0 4px;
}

.docs-pager-card {
    align-items: flex-start;
    padding: 8px 12px;
    border-radius: 3px;
}

.docs-pager-card-next {
    align-items: flex-end;
}

.docs-pager-card-caption {
    font-size: var(--unity-metrics-default-font_small_size);
    color: var(--unity-colors-label-text);
    padding: 0;
    margin: 0 0 2px 0;
}

.docs-pager-card-title {
    white-space: normal;
    padding: 0;
    margin: 0;
}

.docs-pager-card-next .docs-pager-card-title,
.docs-pager-card-next .docs-pager-card-caption {
    -unity-text-align: upper-right;
}

.docs-narrow .docs-pager-cards {
    flex-direction: column;
}

.docs-narrow .docs-pager-card {
    margin-bottom: 6px;
}

.docs-layout-new .docs-table-first {
    flex-grow: 0.6;
}

/* Sections: the heading bar, then the whole section behind one line on the left. It ends where the line ends. */
.docs-section {
    margin-bottom: 4px;
}

.docs-section-body {
    margin-left: 10px;
    padding: 12px 0 4px 16px;
    border-left-width: 2px;
}

/* Parts inside a section: a title with a strong edge, the part behind a faint one of the same colour. */
.docs-part {
    margin-top: 16px;
    margin-bottom: 4px;
}

.docs-part-title {
    -unity-font-style: bold;
    font-size: 13px;
    padding: 2px 0 2px 9px;
    margin: 0;
    border-left-width: 3px;
}

.docs-part-body {
    padding: 8px 0 2px 12px;
    border-left-width: 3px;
}

.docs-part-body > .docs-paragraph:last-child,
.docs-part-body > .docs-facts:last-child,
.docs-part-body > .docs-action-group:last-child {
    margin-bottom: 2px;
}

/* A text sits close under its own heading and far from the one before. */
.docs-section-body > .docs-paragraph:first-child {
    margin-top: 0;
}

/* A button and the rows that describe what it opens. */
.docs-action-group {
    margin-bottom: 12px;
}

.docs-action-group > .docs-action {
    margin-bottom: 0;
    align-self: flex-start;
}

.docs-action-group-facts {
    margin: 0 0 0 14px;
    padding-left: 12px;
    border-top-width: 0;
    border-left-width: 2px;
}

/* The sample box: one line when closed, the steps when open. */
.docs-sample-box {
    margin-top: 16px;
    margin-bottom: 8px;
    border-width: 1px;
    border-radius: 4px;
}

.docs-sample-line {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    padding: 4px 8px 4px 2px;
}

.docs-sample-toggle {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin: 0 8px 0 0;
    padding: 2px 6px;
}

.docs-sample-arrow {
    width: 14px;
    padding: 0;
    margin: 0;
}

.docs-sample-title {
    -unity-font-style: bold;
    font-size: 13px;
    padding: 0;
    margin: 0;
}

.docs-sample-line > .docs-action {
    margin: 0 8px 0 0;
}

.docs-sample-path {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--unity-colors-link-text);
    font-size: var(--unity-metrics-default-font_small_size);
    margin: 0;
    padding: 2px 4px;
}

.docs-sample-path:hover {
    -unity-font-style: bold;
}

.docs-sample-body {
    padding: 6px 12px 6px 30px;
    border-top-width: 1px;
    border-top-color: var(--unity-colors-default-border);
}

/* The sandbox */
.docs-sandbox {
    border-width: 1px;
    border-radius: 4px;
    padding: 10px;
    margin-bottom: 14px;
}

.docs-sandbox-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.docs-sandbox-pill {
    border-width: 1px;
    border-radius: 3px;
    padding: 1px 6px;
    margin: 0 8px 0 0;
    -unity-font-style: bold;
}

.docs-sandbox-lede {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

.docs-sandbox-panels {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 0 -4px;
}

.docs-sandbox-panel {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 360px;
    margin: 0 4px 8px 4px;
    border-width: 1px;
    padding-bottom: 6px;
}

.docs-sandbox-panel-title {
    -unity-font-style: bold;
    padding: 4px 8px;
    margin: 0 0 6px 0;
    border-bottom-width: 1px;
}

.docs-sandbox-field {
    padding: 2px 8px 6px 8px;
}

.docs-sandbox-help {
    white-space: normal;
    font-size: var(--unity-metrics-default-font_small_size);
    color: var(--unity-colors-label-text);
    margin: 2px 3px 0 3px;
    padding: 0;
    opacity: 0.8;
}

.docs-sandbox-field .unity-base-field__label {
    min-width: 170px;
}

.docs-sandbox-run-panel {
    border-width: 1px;
    padding-bottom: 6px;
    margin-bottom: 8px;
}

.docs-sandbox-run-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding: 0 6px;
}

.docs-sandbox-run-row .unity-base-field__label {
    min-width: 0;
    margin-right: 6px;
}

.docs-sandbox-run-change {
    min-width: 280px;
}

.docs-sandbox-run-load {
    min-width: 250px;
    flex-grow: 1;
}

.docs-sandbox-run {
    -unity-font-style: bold;
    padding: 3px 14px;
    margin-left: 8px;
}

.docs-sandbox-verdict {
    white-space: normal;
    padding: 6px 10px 0 10px;
    -unity-font-style: bold;
}

.docs-sandbox-output {
    flex-direction: row;
    flex-wrap: wrap;
}

.docs-sandbox-screen {
    width: 240px;
    height: 135px;
    margin: 0 8px 8px 0;
    border-radius: 3px;
    overflow: hidden;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
}

.docs-sandbox-screen-label {
    color: rgb(235, 235, 235);
    -unity-font-style: bold;
    font-size: 14px;
}

.docs-sandbox-bar {
    width: 160px;
    height: 6px;
    margin-top: 10px;
    border-radius: 3px;
    overflow: hidden;
}

.docs-sandbox-bar-fill {
    height: 100%;
    width: 0;
    transition-property: width;
    transition-duration: 0.15s;
}

.docs-sandbox-cover {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 0;
    transition-property: opacity;
}

.docs-sandbox-console {
    flex-grow: 1;
    flex-basis: 300px;
    height: 220px;
    border-width: 1px;
    margin-bottom: 8px;
    padding: 4px 0;
}

.docs-sandbox-line {
    flex-direction: row;
    padding: 2px 8px;
}

.docs-sandbox-line-time {
    width: 56px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: upper-right;
    margin-right: 10px;
    font-size: var(--unity-metrics-default-font_small_size);
}

.docs-sandbox-line-text {
    flex-grow: 1;
    flex-shrink: 1;
}

.docs-sandbox-line-what {
    white-space: normal;
    margin: 0;
    padding: 0;
}

.docs-sandbox-line-why {
    white-space: normal;
    margin: 0;
    padding: 0;
    font-size: var(--unity-metrics-default-font_small_size);
}
