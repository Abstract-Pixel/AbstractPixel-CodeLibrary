    border-left-width: 0;
}

.docs-section-body > .docs-first,
.docs-part-fold > .unity-foldout__content > .docs-first,
.docs-fold > .unity-foldout__content > .docs-first,
.docs-action-fold > .unity-foldout__content > .docs-first {
    margin-top: 10px;
}

