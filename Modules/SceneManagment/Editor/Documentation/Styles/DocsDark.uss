/* Our own colour tokens, dark skin. Unity has no role for these. Muted to sit with Unity's palette; text contrast 4.5:1 or more. */
.docs-pill { border-width: 1px; }
.docs-pill-0 { background-color: rgba(110, 170, 120, 0.18); border-color: rgba(110, 170, 120, 0.45); color: rgb(170, 210, 175); }
.docs-pill-1 { background-color: rgba(110, 150, 210, 0.18); border-color: rgba(110, 150, 210, 0.45); color: rgb(175, 200, 235); }
.docs-pill-2 { background-color: rgba(160, 130, 200, 0.18); border-color: rgba(160, 130, 200, 0.45); color: rgb(205, 190, 230); }
.docs-pill-3 { background-color: rgba(210, 150, 90, 0.18); border-color: rgba(210, 150, 90, 0.45); color: rgb(230, 195, 160); }
.docs-callout-note { border-left-color: rgb(130, 130, 130); }
.docs-callout-warning { border-left-color: rgb(200, 165, 80); }
.docs-callout-tip { border-left-color: rgb(110, 165, 115); }
.docs-callout-why, .docs-foldout-why { border-left-color: rgb(110, 150, 210); }
.docs-step-circle { border-color: rgb(140, 140, 140); }
.docs-step-done .docs-step-circle { background-color: rgb(80, 135, 88); border-color: rgb(80, 135, 88); color: rgb(255, 255, 255); }
.docs-mark, .docs-mark-number { background-color: rgb(58, 100, 180); }
.docs-chip:hover, .docs-graph-box:hover { background-color: rgb(78, 78, 78); }
.docs-step-current { background-color: rgba(255, 255, 255, 0.05); }
/* New layout: member kinds, decision status, flows. */
.docs-mrow.docs-kind-method { border-left-color: rgb(100, 150, 230); }
.docs-mrow.docs-kind-property { border-left-color: rgb(110, 180, 125); }
.docs-mrow.docs-kind-field { border-left-color: rgb(215, 170, 80); }
.docs-mrow.docs-kind-event { border-left-color: rgb(215, 120, 170); }
.docs-mrow.docs-kind-value { border-left-color: rgb(150, 150, 150); }
.docs-heading-row.docs-kind-method { border-left-width: 4px; border-left-color: rgb(100, 150, 230); }
.docs-heading-row.docs-kind-property { border-left-width: 4px; border-left-color: rgb(110, 180, 125); }
.docs-heading-row.docs-kind-field { border-left-width: 4px; border-left-color: rgb(215, 170, 80); }
.docs-heading-row.docs-kind-event { border-left-width: 4px; border-left-color: rgb(215, 120, 170); }
.docs-heading-row.docs-kind-value { border-left-width: 4px; border-left-color: rgb(150, 150, 150); }
.docs-status-accepted { background-color: rgba(110, 170, 120, 0.18); border-color: rgba(110, 170, 120, 0.45); color: rgb(170, 210, 175); }
.docs-status-amended { background-color: rgba(210, 150, 90, 0.18); border-color: rgba(210, 150, 90, 0.45); color: rgb(230, 195, 160); }
.docs-flow-number { border-color: rgb(110, 150, 210); color: rgb(175, 200, 235); background-color: rgba(110, 150, 210, 0.15); }
.docs-flow-phase { border-left-color: rgb(110, 150, 210); }
.docs-mrow:hover { background-color: rgba(255, 255, 255, 0.03); }
/* New layout: section and part edges, the sample box, the sandbox. */
.docs-section-body { border-left-color: rgba(255, 255, 255, 0.16); }
.docs-part-title { border-left-color: rgb(110, 150, 210); }
.docs-part-body { border-left-color: rgba(110, 150, 210, 0.22); }
.docs-action-group-facts { border-left-color: rgba(255, 255, 255, 0.16); }
.docs-sample-box { border-color: rgba(110, 170, 120, 0.45); background-color: rgba(110, 170, 120, 0.06); }
.docs-sandbox { border-color: rgba(210, 150, 90, 0.5); background-color: rgba(0, 0, 0, 0.12); }
.docs-sandbox-pill { background-color: rgba(210, 150, 90, 0.2); border-color: rgba(210, 150, 90, 0.5); color: rgb(230, 195, 160); }
.docs-sandbox-panel, .docs-sandbox-run-panel { background-color: rgb(56, 56, 56); border-color: rgb(36, 36, 36); }
.docs-sandbox-panel-title { background-color: rgb(62, 62, 62); border-color: rgb(36, 36, 36); }
.docs-sandbox-console { background-color: rgb(30, 30, 30); border-color: rgb(20, 20, 20); }
.docs-sandbox-line-time { color: rgb(130, 130, 130); }
.docs-sandbox-line-why { color: rgb(150, 150, 150); }
.docs-sandbox-line-warning .docs-sandbox-line-what { color: rgb(230, 190, 90); }
.docs-sandbox-screen-old { background-color: rgb(60, 80, 120); }
.docs-sandbox-screen-loading { background-color: rgb(40, 40, 46); }
.docs-sandbox-screen-new { background-color: rgb(60, 110, 70); }
.docs-sandbox-bar { background-color: rgb(70, 70, 76); }
.docs-sandbox-bar-fill { background-color: rgb(110, 170, 230); }
.docs-sandbox-verdict { color: rgb(230, 195, 160); }
