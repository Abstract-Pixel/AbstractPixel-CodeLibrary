/* Layout and Unity's own colour roles. Our own colour tokens live in DocsDark.uss and DocsLight.uss. */
.docs-window {
    flex-grow: 1;
    background-color: var(--unity-colors-window-background);
}

.docs-toolbar {
    flex-shrink: 0;
}

.docs-toolbar-icon {
    padding-left: 3px;
    padding-right: 3px;
    justify-content: center;
    align-items: center;
}

.docs-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

.docs-crumbs {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
    padding-left: 6px;
    color: var(--unity-colors-label-text);
    opacity: 0.6;
}

.docs-on-this-page {
    flex-shrink: 0;
}

.docs-search {
    flex-shrink: 1;
    min-width: 60px;
    width: 180px;
}

.docs-narrow .docs-search {
    width: 90px;
}

.docs-narrow .docs-crumbs {
    display: none;
}

.docs-split {
    flex-grow: 1;
}

.docs-sidebar {
    background-color: var(--unity-colors-default-background);
    border-right-width: 1px;
    border-right-color: var(--unity-colors-default-border);
    min-width: 120px;
}

.docs-page-scroll {
    flex-grow: 1;
}

.docs-page {
    max-width: 716px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 8px;
    padding-bottom: 16px;
}

.docs-empty {
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 48px;
    color: var(--unity-colors-label-text);
}
