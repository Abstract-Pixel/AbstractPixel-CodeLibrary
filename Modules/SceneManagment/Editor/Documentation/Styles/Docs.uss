/* Layout and Unity's own colour roles. Our own colour tokens live in DocsDark.uss and DocsLight.uss. */
.docs-window {
    flex-grow: 1;
    background-color: var(--unity-colors-window-background);
}

.docs-hidden {
    display: none;
}

.docs-toolbar {
    flex-shrink: 0;
}

.docs-toolbar-icon {
    font-size: 14px;
    min-width: 22px;
    padding-left: 3px;
    padding-right: 3px;
    justify-content: center;
    align-items: center;
}

.docs-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

.docs-crumbs {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
    padding-left: 6px;
    color: var(--unity-colors-label-text);
    opacity: 0.6;
}

.docs-on-this-page {
    flex-shrink: 0;
}

.docs-search {
    flex-shrink: 1;
    min-width: 60px;
    width: 180px;
}

.docs-narrow .docs-search {
    width: 90px;
}

.docs-narrow .docs-crumbs {
    display: none;
}

/* The trail of recent pages in the toolbar. */
.docs-trail {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    flex-grow: 0;
    flex-shrink: 1;
    max-width: 55%;
    overflow: hidden;
    padding: 0 8px;
    border-left-width: 1px;
    border-left-color: var(--unity-colors-toolbar-border);
}

.docs-trail-lead {
    color: var(--unity-colors-label-text);
    opacity: 0.6;
    margin: 0 6px 0 0;
    padding: 0;
    flex-shrink: 0;
}

.docs-trail-link {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin: 0;
    padding: 0 2px;
    color: var(--unity-colors-link-text);
    flex-shrink: 1;
}

.docs-trail-link:hover {
    -unity-font-style: bold;
}

.docs-trail-separator {
    color: var(--unity-colors-label-text);
    opacity: 0.6;
    padding: 0 3px;
    margin: 0;
}

.docs-trail-current {
    -unity-font-style: bold;
    padding: 0 2px;
    margin: 0;
    flex-shrink: 1;
}

.docs-split {
    flex-grow: 1;
}

.docs-sidebar {
    background-color: var(--unity-colors-default-background);
    border-right-width: 1px;
    border-right-color: var(--unity-colors-default-border);
    min-width: 120px;
    flex-grow: 1;
}

.docs-tree {
    flex-grow: 1;
}

.docs-tree-label {
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
}

.docs-results {
    flex-grow: 1;
}

.docs-result {
    padding-left: 6px;
    padding-top: 2px;
}

.docs-result-category {
    font-size: var(--unity-metrics-default-font_small_size);
    color: var(--unity-colors-label-text);
    opacity: 0.6;
}

.docs-page-scroll {
    flex-grow: 1;
}

.docs-page {
    max-width: 716px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 8px;
    padding-bottom: 16px;
}

.docs-empty {
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 48px;
    color: var(--unity-colors-label-text);
}

/* Prose */
.docs-text {
    white-space: normal;
    color: var(--unity-colors-default-text);
    font-size: var(--unity-metrics-default-font_normal_size);
    padding: 0;
    margin: 0;
}

.docs-paragraph {
    margin-bottom: 8px;
}

.docs-title-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 8px;
}

.docs-title {
    font-size: var(--unity-metrics-default-font_very_big_size);
    -unity-font-style: bold;
    white-space: normal;
    margin-right: 8px;
    flex-shrink: 1;
}

.docs-heading-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 16px;
    margin-bottom: 4px;
    transition-property: background-color;
    transition-duration: 1s;
}

.docs-heading {
    -unity-font-style: bold;
    white-space: normal;
    flex-shrink: 1;
    margin-right: 6px;
}

.docs-h2 .docs-heading {
    font-size: var(--unity-metrics-default-font_big_size);
}

.docs-h3 .docs-heading {
    font-size: var(--unity-metrics-default-font_normal_size);
}

.docs-flash {
    background-color: var(--unity-colors-highlight-background);
}

.docs-anchor {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--unity-colors-label-text);
    opacity: 0.5;
    padding: 0 2px;
    margin: 0;
}

.docs-anchor:hover {
    opacity: 1;
}

/* Pills and badges */
.docs-pill {
    font-size: var(--unity-metrics-default-font_small_size);
    border-radius: 3px;
    padding: 0 5px;
    margin-right: 4px;
    -unity-text-align: middle-center;
}

.docs-kind {
    font-size: var(--unity-metrics-default-font_small_size);
    border-radius: 3px;
    padding: 0 4px;
    margin-right: 6px;
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
    color: var(--unity-colors-label-text);
}

/* Lists */
.docs-list {
    margin-bottom: 8px;
}

.docs-list-nested {
    margin-left: 15px;
    margin-bottom: 0;
}

.docs-list-row {
    flex-direction: row;
    margin-bottom: 2px;
}

.docs-list-marker {
    min-width: 15px;
    color: var(--unity-colors-label-text);
    padding: 0;
    margin: 0;
}

.docs-list-content {
    flex-shrink: 1;
    flex-grow: 1;
}

/* Steps */
.docs-steps {
    margin-bottom: 8px;
}

.docs-step {
    flex-direction: row;
    padding: 2px;
    margin-bottom: 2px;
}

.docs-step-current {
    border-left-width: 2px;
    border-left-color: var(--unity-colors-highlight-background);
}

.docs-step {
    padding-left: 6px;
}

.docs-step-circle {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border-width: 1px;
    -unity-text-align: middle-center;
    font-size: var(--unity-metrics-default-font_small_size);
    margin-right: 6px;
    flex-shrink: 0;
    padding: 0;
}

.docs-step-content {
    flex-shrink: 1;
    flex-grow: 1;
}

/* Tables */
.docs-table {
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
    margin-bottom: 8px;
}

.docs-table-row {
    flex-direction: row;
}

.docs-table-header {
    background-color: var(--unity-colors-inspector_titlebar-background);
}

.docs-table-header .docs-table-cell {
    -unity-font-style: bold;
}

.docs-table-alternate {
    background-color: var(--unity-colors-alternated_rows-background);
}

.docs-table-cell {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    padding: 2px 4px;
}

/* Quotes, callouts, foldouts */
.docs-quote {
    border-left-width: 3px;
    border-left-color: var(--unity-colors-default-border);
    padding-left: 10px;
    margin-bottom: 8px;
}

.docs-callout {
    background-color: var(--unity-colors-helpbox-background);
    border-width: 1px;
    border-color: var(--unity-colors-helpbox-border);
    border-left-width: 3px;
    padding: 6px 10px 6px 10px;
    margin-bottom: 8px;
}

.docs-callout-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.docs-callout-title {
    -unity-font-style: bold;
    margin-left: 4px;
}

.docs-callout-body .docs-paragraph {
    margin-bottom: 2px;
}

.docs-foldout {
    margin-bottom: 8px;
}

.docs-foldout-why {
    background-color: var(--unity-colors-helpbox-background);
    border-left-width: 3px;
    padding: 2px 6px 2px 10px;
}

/* Code */
.docs-code {
    background-color: var(--unity-colors-default-background);
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
    margin-bottom: 8px;
}

.docs-code-header {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    padding: 2px 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}

.docs-code-title {
    flex-grow: 1;
    flex-shrink: 1;
    color: var(--unity-colors-label-text);
    overflow: hidden;
    text-overflow: ellipsis;
}

.docs-code-scroll {
    padding: 4px;
}

.docs-code-row {
    flex-direction: row;
}

.docs-code-gutter {
    color: var(--unity-colors-label-text);
    opacity: 0.6;
    -unity-text-align: upper-right;
    margin-right: 8px;
    padding: 0;
}

.docs-code-text {
    white-space: nowrap;
    padding: 0;
    margin: 0;
}

/* Chips and link buttons */
.docs-chip {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    border-radius: 3px;
    padding: 1px 6px;
    margin: 2px 4px 2px 0;
    transition-property: background-color;
    transition-duration: 0.1s;
}

.docs-glyph {
    color: var(--unity-colors-label-text);
    -unity-text-align: middle-center;
    min-width: 12px;
    margin: 0 4px 0 0;
    padding: 0;
}

.docs-callout-glyph {
    -unity-font-style: bold;
    width: 16px;
    margin-right: 0;
}

.docs-action {
    margin-top: 2px;
    margin-bottom: 6px;
}

.docs-link-button {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
    margin: 0;
    -unity-text-align: middle-left;
    align-self: flex-start;
    color: var(--unity-colors-link-text);
    white-space: normal;
}

.docs-link-button:hover {
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-link-text);
}

/* Images and marks */
.docs-figure {
    margin-bottom: 8px;
}

.docs-image-frame {
    width: 100%;
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
}

.docs-image {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.docs-mark {
    position: absolute;
    width: 18px;
    height: 18px;
    margin-left: -9px;
    margin-top: -9px;
    border-radius: 9px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: var(--unity-metrics-default-font_small_size);
    padding: 0;
    color: rgb(255, 255, 255);
}

.docs-mark-list {
    margin-top: 4px;
}

.docs-mark-row {
    flex-direction: row;
    margin-bottom: 2px;
}

.docs-mark-number {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    -unity-text-align: middle-center;
    font-size: var(--unity-metrics-default-font_small_size);
    margin-right: 6px;
    padding: 0;
    color: rgb(255, 255, 255);
    flex-shrink: 0;
}

.docs-caption {
    white-space: normal;
    font-size: var(--unity-metrics-default-font_small_size);
    color: var(--unity-colors-label-text);
    opacity: 0.6;
    margin-top: 2px;
}

.docs-image-missing {
    color: var(--unity-colors-error-text);
}

/* Members, code map, design decisions */
.docs-member {
    margin-bottom: 6px;
}

.docs-member-header {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.docs-member-name {
    flex-shrink: 1;
    white-space: normal;
}

.docs-member-summary {
    margin-left: 15px;
}

/* Timeline */
.docs-timeline {
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
    padding: 4px 6px;
    margin-bottom: 8px;
}

.docs-timeline-title {
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.docs-timeline-empty {
    white-space: normal;
    color: var(--unity-colors-label-text);
}

.docs-timeline-list {
    max-height: 320px;
}

.docs-timeline-row {
    padding: 2px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}

.docs-timeline-header {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.docs-timeline-time {
    min-width: 52px;
    color: var(--unity-colors-label-text);
}

.docs-timeline-detail {
    color: var(--unity-colors-label-text);
    margin-left: 6px;
}

/* Your project */
.docs-your-project {
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
    padding: 4px 8px;
    margin-bottom: 8px;
}

.docs-your-project-title {
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.docs-fact {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 2px;
}

.docs-fact-label {
    min-width: 150px;
    color: var(--unity-colors-label-text);
}

.docs-fact-value {
    flex-shrink: 1;
    white-space: normal;
}

/* Graphs (Home parts, code map) */
.docs-graph {
    margin-bottom: 12px;
}

.docs-graph-crumbs {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 8px;
}

.docs-graph-crumb-current {
    -unity-font-style: bold;
    color: var(--unity-colors-default-text);
}

.docs-graph-separator {
    margin: 0 6px;
    color: var(--unity-colors-label-text);
}

.docs-graph-canvas {
    margin-bottom: 6px;
}

.docs-graph-box {
    position: absolute;
    margin: 0;
    padding: 4px 8px;
    border-radius: 3px;
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
    background-color: var(--unity-colors-default-background);
    align-items: flex-start;
    justify-content: center;
    transition-property: opacity, background-color;
    transition-duration: 0.1s;
}

.docs-graph-key {
    border-width: 2px;
    border-color: var(--unity-colors-highlight-background);
}

.docs-graph-dim {
    opacity: 0.35;
}

.docs-graph-title {
    -unity-font-style: bold;
    -unity-text-align: upper-left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 0;
    margin: 0;
}

.docs-graph-line {
    -unity-text-align: upper-left;
    font-size: var(--unity-metrics-default-font_small_size);
    color: var(--unity-colors-label-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 0;
    margin: 0;
}

.docs-graph-everything-toggle {
    margin: 2px 0 4px 0;
}

.docs-graph-section {
    margin-top: 8px;
    padding-left: 10px;
    border-left-width: 1px;
    border-left-color: var(--unity-colors-default-border);
}

/* Pager */
.docs-pager {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-top: 24px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: var(--unity-colors-default-border);
}

.docs-pager-button {
    white-space: normal;
    max-width: 48%;
}

/* Help row in inspectors and help buttons */
.docs-help-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.docs-help-summary {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    color: var(--unity-colors-label-text);
}

.docs-help-button {
    width: 20px;
    height: 18px;
    padding: 1px;
    margin: 0 0 0 4px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.docs-help-button:hover {
    background-color: var(--unity-colors-button-background-hover);
}

/* The page and the "On this page" rail beside it. */
.docs-page-area {
    flex-direction: row;
    flex-grow: 1;
}

.docs-page-area > .docs-page-scroll {
    flex-grow: 1;
    flex-shrink: 1;
}

.docs-rail {
    display: none;
    width: 230px;
    flex-shrink: 0;
    padding: 16px 10px 10px 12px;
    border-left-width: 1px;
    border-left-color: var(--unity-colors-default-border);
}

.docs-wide.docs-has-rail .docs-rail {
    display: flex;
}

.docs-wide.docs-has-rail .docs-on-this-page {
    display: none;
}

.docs-rail-title {
    -unity-font-style: bold;
    margin: 0 0 6px 0;
    padding: 0 0 6px 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}

.docs-rail-list {
    flex-grow: 1;
}

/* Rows like a Unity tree view: a fold arrow, a muted number, the title on one line. */
.docs-rail-row {
    flex-direction: row;
    align-items: center;
    height: 20px;
    padding: 0 4px 0 0;
    border-radius: 2px;
}

.docs-rail-row:hover {
    background-color: var(--unity-colors-highlight-background-hover);
}

.docs-rail-arrow {
    width: 14px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    color: var(--unity-colors-label-text);
    font-size: 10px;
}

.docs-rail-number {
    min-width: 22px;
    flex-shrink: 0;
    margin: 0;
    padding: 0 4px 0 0;
    color: var(--unity-colors-label-text);
    opacity: 0.55;
    -unity-text-align: middle-left;
}

.docs-rail-text {
    flex-shrink: 1;
    flex-grow: 1;
    margin: 0;
    padding: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-left;
}

.docs-rail-section {
    margin-top: 2px;
}

.docs-rail-section .docs-rail-text {
    -unity-font-style: bold;
}

/* Parts sit under their section behind a thin guide line. */
.docs-rail-children {
    margin-left: 10px;
    padding-left: 6px;
    border-left-width: 1px;
    border-left-color: var(--unity-colors-default-border);
}

.docs-rail-part .docs-rail-text,
.docs-rail-part .docs-rail-number {
    font-size: var(--unity-metrics-default-font_small_size);
}

.docs-rail-part .docs-rail-arrow {
    width: 4px;
}

/* The section you are reading shows as the selected row. */
.docs-rail-current {
    background-color: var(--unity-colors-highlight-background);
}

.docs-rail-current .docs-rail-text,
.docs-rail-current .docs-rail-number,
.docs-rail-current .docs-rail-arrow {
    color: var(--unity-colors-highlight-text);
    opacity: 1;
}
