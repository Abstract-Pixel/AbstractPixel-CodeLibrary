.setup-problems-window__row {
    margin: 6px;
    padding: 6px;
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.35);
    border-radius: 3px;
}

.setup-problems-window__row-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.setup-problems-window__button-row {
    flex-direction: row;
    justify-content: flex-end;
    padding: 6px;
}
