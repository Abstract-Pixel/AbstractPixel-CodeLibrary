.saved-object-card {
    margin-top: 6px;
    margin-bottom: 2px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 6px;
    padding-right: 4px;
    border-left-width: 2px;
    border-left-color: rgb(90, 90, 90);
}

.saved-object-card__body {
    margin-left: 8px;
    overflow: hidden;
}

.saved-object-card__field-row {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
    flex-wrap: wrap;
    max-width: 100%;
}

.saved-object-card__field-formerly {
    color: rgb(150, 150, 150);
    margin-left: 6px;
}

.saved-object-card__field-value {
    color: rgb(150, 150, 150);
    margin-left: 6px;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

.saved-object-card__custom-data-value {
    white-space: pre;
    color: rgb(150, 150, 150);
    margin-top: 2px;
}

.saved-object-card__error {
    color: rgb(220, 120, 120);
    margin-top: 4px;
}

.saved-object-card__note {
    color: rgb(150, 150, 150);
    margin-top: 4px;
}

.saved-object-card__header-label {
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.saved-object-card__header-save-id-button {
    flex-shrink: 0;
    margin-left: 4px;
    margin-top: 0;
    margin-bottom: 0;
}

.saved-object-card__save-id-row {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
    margin-left: 8px;
    max-width: 100%;
}

.saved-object-card__save-id-label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: rgb(150, 150, 150);
}
