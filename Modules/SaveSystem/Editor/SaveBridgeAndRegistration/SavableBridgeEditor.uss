.savable-target {
    margin-top: 6px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 6px;
    border-left-width: 2px;
    border-left-color: rgb(90, 90, 90);
}

.savable-target__script-name {
    -unity-font-style: bold;
}

.savable-target__id-row {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

.savable-target__id-label {
    flex-grow: 1;
    color: rgb(150, 150, 150);
}
