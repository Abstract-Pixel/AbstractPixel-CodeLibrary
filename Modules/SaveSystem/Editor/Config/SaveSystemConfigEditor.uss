.save-file-row {
    flex-direction: row;
    align-items: center;
}

.save-file-row__name {
    flex-grow: 1;
    flex-basis: 40%;
}

.save-file-row__location {
    flex-grow: 1;
    flex-basis: 30%;
}

.save-file-row__line2 {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 2px;
}

.save-file-row__backup {
    margin-left: 6px;
    flex-grow: 0;
}

/* Unity's default field label reserves a wide min-width so labels line up across a column of
   fields. This Toggle's "Backup" label isn't lining up with anything else, so that reserved
   width just reads as a large, unexplained gap before its own checkbox. */
.save-file-row__backup .unity-base-field__label {
    min-width: 0;
    width: auto;
    margin-right: 3px;
}

.save-file-row__class {
    -unity-font-style: italic;
    color: rgb(150, 150, 150);
    flex-shrink: 1;
    -unity-text-align: middle-right;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.save-file-row__note {
    margin-left: 4px;
    -unity-font-style: italic;
    color: rgb(150, 150, 150);
}

.save-file-list__actions {
    margin-top: 6px;
    margin-bottom: 6px;
}

.save-file-list__waiting {
    margin-top: 6px;
    -unity-font-style: italic;
    color: rgb(150, 150, 150);
}

.save-file-row__clash {
    margin-top: 2px;
}

.save-file-row__clash--hidden {
    display: none;
}
