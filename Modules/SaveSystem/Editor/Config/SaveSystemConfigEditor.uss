.save-file-row {
    flex-direction: row;
    align-items: center;
}

.save-file-row__name {
    flex-grow: 1;
    flex-basis: 40%;
}

.save-file-row__location {
    flex-grow: 1;
    flex-basis: 30%;
}

.save-file-row__backup {
    margin-left: 6px;
}

.save-file-row__note {
    margin-left: 4px;
    -unity-font-style: italic;
    color: rgb(150, 150, 150);
}

.save-file-list__actions {
    margin-top: 6px;
    margin-bottom: 6px;
}
