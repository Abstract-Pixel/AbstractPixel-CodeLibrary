.save-file-row {
    flex-direction: row;
    align-items: center;
}

.save-file-row__name {
    flex-grow: 1;
    flex-basis: 40%;
}

.save-file-row__location {
    flex-grow: 1;
    flex-basis: 30%;
}

.save-file-row__line2 {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

.save-file-row__backup {
    margin-left: 6px;
    flex-grow: 0;
}

.save-file-row__class {
    -unity-font-style: italic;
    color: rgb(150, 150, 150);
    flex-shrink: 1;
    margin-left: 14px;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.save-file-row__note {
    margin-left: 4px;
    -unity-font-style: italic;
    color: rgb(150, 150, 150);
}

.save-file-list__actions {
    margin-top: 6px;
    margin-bottom: 6px;
}

.save-file-list__waiting {
    margin-top: 6px;
    -unity-font-style: italic;
    color: rgb(150, 150, 150);
}

.save-file-row__clash {
    margin-top: 2px;
}

.save-file-row__clash--hidden {
    display: none;
}
