<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="Onboarding.uss" />
    <ui:VisualElement class="gm-root gm-onboarding">
<ui:ScrollView horizontal-scroller-visibility="Hidden" class="gm-onboarding-scroll">
<ui:VisualElement class="gm-logo-row"><ui:Image name="logo" class="gm-logo" /></ui:VisualElement>
<ui:VisualElement class="gm-pill-row" name="pillHost" />
<ui:VisualElement class="gm-separator" />
<ui:VisualElement class="gm-content-inner">
<ui:Label text="Ready" class="gm-page-header" />
<ui:Label text="This is what will be made." class="gm-page-line" />
<ui:VisualElement class="gm-card gm-card-flat" name="readyCard"><ui:VisualElement name="readyContainer" /></ui:VisualElement>
<ui:Label text="Change these later in Project Settings &#8250; Abstract Pixel &#8250; Game Management." class="gm-hint gm-later" />
</ui:VisualElement>
</ui:ScrollView>
<ui:VisualElement class="gm-footer"><ui:VisualElement class="gm-footer-inner"><ui:Button text="Back" name="backButton" class="gm-footer-button" /><ui:Label text="" name="stepLabel" class="gm-step" /><ui:Button text="Set up" name="nextButton" class="gm-footer-button gm-primary-button" /></ui:VisualElement></ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
