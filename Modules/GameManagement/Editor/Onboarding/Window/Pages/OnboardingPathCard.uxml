<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
<ui:VisualElement class="gm-choice-card" name="pathCard"><ui:Label text="1" name="cardIndex" class="gm-box-index" /><ui:Label text="Main Menu" name="cardName" class="gm-choice-name" /><ui:RadioButtonGroup name="pathRadio" value="0" class="gm-radio-row" /><ui:Toggle name="settingsToggle" text="Include a Settings screen" value="false" class="gm-settings-toggle" /><ui:Label text="&lt;b&gt;NOTE:&lt;/b&gt; Adds a Settings sub-state, opening over this menu." enable-rich-text="true" name="settingsHint" class="gm-hint gm-settings-hint" /><ui:VisualElement name="ownExtra" class="gm-own-extra"><uie:ObjectField name="prefab-menu" label="Your menu (prefab)" /><ui:Label name="prefabProblem" class="gm-hint gm-problem-text" /><ui:VisualElement class="gm-row"><ui:Label text="&lt;b&gt;NOTE:&lt;/b&gt; Needs extra setup: wire your buttons." enable-rich-text="true" class="gm-hint" /><ui:Button text="Learn more" name="learnMore" class="gm-link gm-inline-link" /></ui:VisualElement></ui:VisualElement></ui:VisualElement>
</ui:UXML>
