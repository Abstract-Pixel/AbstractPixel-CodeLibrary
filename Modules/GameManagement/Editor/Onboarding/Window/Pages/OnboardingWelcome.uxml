<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="Onboarding.uss" />
    <ui:VisualElement class="gm-root gm-onboarding">
<ui:ScrollView horizontal-scroller-visibility="Hidden" class="gm-onboarding-scroll">
<ui:VisualElement class="gm-logo-row"><ui:Image name="logo" class="gm-logo gm-logo-welcome" /></ui:VisualElement>
<ui:VisualElement class="gm-pill-row" name="pillHost" />
<ui:VisualElement class="gm-separator" />
<ui:VisualElement class="gm-content-inner">
<ui:Label text="Welcome" class="gm-page-header gm-page-header-welcome" />
<ui:Label text="A few words this tool uses, before you set anything up." class="gm-page-line gm-page-line-welcome" />
<ui:Foldout text="Terminology" value="false" class="gm-terminology-foldout">
<ui:VisualElement class="gm-card gm-term-card"><ui:Label text="1" class="gm-box-index" /><ui:Label text="State" class="gm-term-name" /><ui:Label text="One named situation of the game, such as Main Menu, Play, Pause or Game Over." class="gm-term-line" /></ui:VisualElement>
<ui:VisualElement class="gm-card gm-term-card"><ui:Label text="2" class="gm-box-index" /><ui:Label text="Sub-state" class="gm-term-name" /><ui:Label text="A state that opens over one of its parents and returns to it on close." class="gm-term-line" /></ui:VisualElement>
<ui:VisualElement class="gm-card gm-term-card"><ui:Label text="3" class="gm-box-index" /><ui:Label text="Requester" class="gm-term-name" /><ui:Label text="A scene script that asks for a state to be entered or left, such as a key press or a button." class="gm-term-line" /></ui:VisualElement>
<ui:VisualElement class="gm-card gm-term-card"><ui:Label text="4" class="gm-box-index" /><ui:Label text="Reactor" class="gm-term-name" /><ui:Label text="A scene script that responds to state changes, such as a menu, audio or HUD." class="gm-term-line" /></ui:VisualElement>
</ui:Foldout>
</ui:VisualElement>
</ui:ScrollView>
<ui:VisualElement class="gm-footer"><ui:VisualElement class="gm-footer-inner"><ui:Button text="Back" name="backButton" class="gm-footer-button" /><ui:Label text="" name="stepLabel" class="gm-step" /><ui:Button text="Next" name="nextButton" class="gm-footer-button gm-primary-button" /></ui:VisualElement></ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
